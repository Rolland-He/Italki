        "introduction": "",
        "about_me": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435! \u041c\u0435\u043d\u044f \u0437\u043e\u0432\u0443\u0442 \u0413\u0443\u043b\u0438\u0440\u0443\u0445, \u043c\u043e\u0436\u043d\u043e \u043a\u0440\u0430\u0442\u043a\u043e \u0413\u0443\u043b\u0438. \u0418\u0437\u0443\u0447\u0430\u044e \u044f\u0437\u044b\u043a\u0438 \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430. \u0413\u043e\u0432\u043e\u0440\u044e \u043d\u0430 5 \u044f\u0437\u044b\u043a\u0430\u0445: \u0443\u0437\u0431\u0435\u043a\u0441\u043a\u0438\u0439, \u0442\u0443\u0440\u043a\u043c\u0435\u043d\u0441\u043a\u0438\u0439, \u0440\u0443\u0441\u0441\u043a\u0438\u0439, \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0439, \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439 \u0438 \u043d\u0435\u043c\u0435\u0446\u043a\u0438\u0439. \u0418\u043c\u0435\u044e \u0434\u0438\u043f\u043b\u043e\u043c \u0444\u0438\u043b\u043e\u043b\u043e\u0433\u0430 \u0438 \u043f\u0435\u0434\u0430\u0433\u043e\u0433\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e \u0438 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u043e\u0432. \u0415\u0441\u0442\u044c \u043e\u043f\u044b\u0442 \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u043d\u0438\u044f \u0432 \u0448\u043a\u043e\u043b\u0430\u0445, \u0434\u0430\u043b\u0435\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0430 \u0432\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0439 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438, \u0433\u0434\u0435 \u0443\u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u043d\u0443\u044e \u0440\u0435\u0447\u044c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430. \u041b\u044e\u0431\u043b\u044e \u0447\u0438\u0442\u0430\u0442\u044c \u0441\u0442\u0430\u0442\u044c\u0438 \u043d\u0430 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445 \u044f\u0437\u044b\u043a\u0430\u0445 \u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0444\u0438\u043b\u044c\u043c\u044b \u0432 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0435, \u0447\u0442\u043e\u0431\u044b \u043e\u0431\u043e\u0433\u0430\u0449\u0430\u0442\u044c \u0441\u043b\u043e\u0432\u0430\u0440\u043d\u044b\u0439 \u0437\u0430\u043f\u0430\u0441. \n\u041a\u0440\u043e\u043c\u0435 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u044f\u0437\u044b\u043a\u043e\u0432 \u0443\u0432\u043b\u0435\u043a\u0430\u044e\u0441\u044c \u0435\u0449\u0435 \u0438 \u0440\u0438\u0441\u043e\u0432\u0430\u043d\u0438\u0435\u043c. \u0420\u0438\u0441\u0443\u044e \u0430\u043a\u0440\u0438\u043b\u043e\u043c \u0438 \u0430\u043a\u0432\u0430\u0440\u0435\u043b\u044c\u044e.",
        "about_teacher": "\u041a\u0430\u043a \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u0435\u043b\u044c \u043a\u043e\u043b\u043b\u0435\u0433\u0438 \u043c\u0435\u043d\u044f \u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u043f\u0443\u043d\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439, \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0438 \u0434\u043e\u0431\u0440\u043e\u0439. \u0423\u0441\u043f\u0435\u0445 \u0438\u0437\u0443\u0447\u0430\u044e\u0449\u0438\u0445 \u043c\u0435\u043d\u044f \u043e\u0447\u0435\u043d\u044c \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0435\u0442, \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435\u043c \u043e\u0442 \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u044b.",
        "teaching_style": "\u0413\u043b\u0430\u0432\u043d\u044b\u043c \u043e\u0431\u0437\u043e\u0440\u043e\u043c, \u0441\u0447\u0438\u0442\u0430\u044e, \u0447\u0442\u043e \u043a\u0430\u0436\u0434\u044b\u0439 \u0443\u0440\u043e\u043a \u0434\u043e\u043b\u0436\u0435\u043d \u0434\u0430\u0442\u044c \u0443\u0447\u0435\u043d\u0438\u043a\u0443 \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c \u0438\u0437\u0443\u0447\u0430\u0442\u044c \u044f\u0437\u044b\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043d \u0432\u044b\u0431\u0440\u0430\u043b. \u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043d\u0443\u0436\u043d\u043e \u043f\u0440\u0435\u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c \u0443\u0440\u043e\u043a\u0438 \u043f\u0440\u043e\u0441\u0442\u043e, \u0434\u043e\u0445\u043e\u0434\u0447\u0438\u0432\u043e, \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u043e. \n\u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u0442\u0435\u043c\u044b, \u043d\u0443\u0436\u043d\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u044b\u043c \u044f\u0437\u044b\u043a\u043e\u043c, \u043f\u0440\u0438\u0432\u043e\u0434\u044f \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0438\u043c\u0435\u0440\u044b, \u0447\u0442\u043e\u0431 \u0431\u044b\u0441\u0442\u0440\u043e \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c \u0438 \u043d\u0435 \u0437\u0430\u0431\u044b\u0442\u044c. \u0412\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u043b\u0443\u0448\u0430\u0442\u044c \u0438\u0437\u0443\u0447\u0430\u044e\u0449\u0435\u0433\u043e \u0438 \u0434\u0430\u0432\u0430\u0442\u044c \u0441\u043e\u0432\u0435\u0442\u044b \u043a\u0430\u043a \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u0442\u0443 \u0438\u043b\u0438 \u0438\u043d\u0443\u044e \u043e\u0448\u0438\u0431\u043a\u0443.",
